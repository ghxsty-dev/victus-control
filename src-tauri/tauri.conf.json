{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Victus Control",
  "version": "0.1.0",
  "identifier": "com.victus.control",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Victus Control - Fan + Güç Limiti",
        "width": 1120,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Utility",
    "shortDescription": "HP Victus fan eğrisi ve CPU/GPU güç limiti",
    "longDescription": "Ryzen 7840HS + RTX 4060 için sıcaklık izleme, fan eğrisi (nbfc/hwmon), ryzenadj CPU limiti ve nvidia-smi GPU limiti."
  }
}
